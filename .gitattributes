# Finales de línea: LF en el repositorio y en la copia de trabajo, en
# todas las máquinas (el atributo eol manda sobre core.autocrlf).
* text=auto eol=lf

# Scripts de Windows: CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: sin conversión ni diff de texto.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.xlsx binary
*.xls binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
